# =============================================================================
#  Prata - modelo de variaveis de ambiente
# =============================================================================
#  Copie para .env e preencha.  O .env esta no .gitignore e deve continuar la.
#  Nenhum valor real de token, chave ou senha entra neste arquivo.
#
#  Em producao nada disso vem de arquivo: vem do cofre do provedor
#  (Fly secrets / Azure Key Vault / Vercel Environment Variables).
#  Ver docs/14-AMBIENTES-E-OPERACAO.md.
#
#  Legenda:  [obrigatorio]  [opcional]  [etapa em que passa a ser necessario]
# =============================================================================


# -----------------------------------------------------------------------------
#  Geral                                                             [E1]
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
TZ=America/Sao_Paulo

# Dominio raiz da plataforma. O tenant e resolvido como {slug}.PRATA_ROOT_DOMAIN
# Ver docs/03-MULTI-TENANCY.md e ADR-0004.
PRATA_ROOT_DOMAIN=prata.localhost
PRATA_PUBLIC_BASE_URL=http://prata.localhost:3000
PRATA_API_BASE_URL=http://localhost:5080


# -----------------------------------------------------------------------------
#  Banco de dados                                                    [E1]
# -----------------------------------------------------------------------------
#  DUAS strings de conexao, de proposito. Ver docs/11-MODELO-DE-DADOS.md.
#
#   - MIGRATION usa prata_owner: dono das tabelas, aplica DDL.
#   - APP usa prata_app: NOBYPASSRLS, nao e dono de nada.
#
#  Se a API subir com a string de migration, a Row Level Security passa a ser
#  decoracao: o dono da tabela ignora policy. Isso e um incidente de
#  vazamento entre tenants esperando acontecer. Ver RN-TEN-001.
ConnectionStrings__Prata=Host=localhost;Port=5432;Database=prata;Username=prata_app;Password=CHANGE_ME;Include Error Detail=true
ConnectionStrings__PrataMigration=Host=localhost;Port=5432;Database=prata;Username=prata_owner;Password=CHANGE_ME
ConnectionStrings__Hangfire=Host=localhost;Port=5432;Database=prata;Username=prata_owner;Password=CHANGE_ME;Search Path=hangfire

# Segundos. Acima disso a query vai para o log de lentidao.
Database__SlowQueryThresholdMs=300
Database__CommandTimeoutSeconds=30
Database__MaxRetryOnFailure=3


# -----------------------------------------------------------------------------
#  Cache / Redis                                                     [E1]
# -----------------------------------------------------------------------------
ConnectionStrings__Redis=localhost:6379,abortConnect=false
Redis__InstanceName=prata:
# TTL da sessao de galeria de convidado (link + senha, sem conta)
Redis__GuestSessionTtlMinutes=120


# -----------------------------------------------------------------------------
#  Autenticacao                                                      [E1]
# -----------------------------------------------------------------------------
#  Gere com:  openssl rand -base64 64
#  NUNCA reaproveite a chave de dev em producao. Rotacao: docs/12-SEGURANCA-E-LGPD.md
Auth__Jwt__Issuer=https://api.prata.localhost
Auth__Jwt__Audience=prata
Auth__Jwt__SigningKey=CHANGE_ME_GERE_UMA_CHAVE_DE_64_BYTES
Auth__Jwt__AccessTokenMinutes=15
Auth__Jwt__RefreshTokenDays=30
Auth__Lockout__MaxFailedAttempts=5
Auth__Lockout__MinutesLocked=15
# Senha: politica minima. Ver RN-TEN-010.
Auth__Password__MinLength=10


# -----------------------------------------------------------------------------
#  Storage S3 (MinIO em dev, Cloudflare R2 em producao)              [E4]
# -----------------------------------------------------------------------------
#  R2:  Storage__ServiceUrl=https://<account_id>.r2.cloudflarestorage.com
#       Storage__Region=auto
Storage__Provider=S3
Storage__ServiceUrl=http://localhost:9000
Storage__Region=us-east-1
Storage__AccessKey=CHANGE_ME
Storage__SecretKey=CHANGE_ME
Storage__ForcePathStyle=true
Storage__Buckets__Originals=prata-originals
Storage__Buckets__Derivatives=prata-derivatives
Storage__Buckets__Exports=prata-exports
# CDN publico na frente das derivadas. Vazio em dev.
Storage__CdnBaseUrl=
# Validade da URL assinada. Curta de proposito: link que vaza expira rapido.
Storage__PresignedGetTtlMinutes=15
Storage__PresignedPutTtlMinutes=60
Storage__MultipartChunkSizeMb=16
Storage__MaxUploadSizeMb=200


# -----------------------------------------------------------------------------
#  Processamento de imagem                                           [E4]
# -----------------------------------------------------------------------------
Imaging__ThumbWidth=480
Imaging__WebWidth=1600
Imaging__TextureWidth=1024
Imaging__LqipWidth=20
Imaging__JpegQuality=82
Imaging__WebpQuality=80
Imaging__WatermarkOpacity=0.35
Imaging__MaxParallelJobs=4


# -----------------------------------------------------------------------------
#  PSP - pagamento e split                                           [E3]
# -----------------------------------------------------------------------------
#  Sandbox do Asaas:  https://api-sandbox.asaas.com/v3
#  Producao:          https://api.asaas.com/v3
#  A chave e um segredo de plataforma, nao de tenant. Ver docs/08-PAGAMENTOS-SPLIT.md
#  DI: Fake enquanto ApiKey/WebhookSecret forem CHANGE_ME (dev/testes).
#  Com Provider=Asaas + chaves reais, sobe AsaasPaymentGateway (ADR-0005).
#  Webhook: POST /v1/webhooks/asaas com header asaas-access-token = WebhookSecret.
Payments__Provider=Asaas
Payments__Asaas__BaseUrl=https://api-sandbox.asaas.com/v3
Payments__Asaas__ApiKey=CHANGE_ME
# Segredo usado para validar a assinatura do webhook. Sem isso, qualquer um
# consegue marcar uma cobranca como paga. Ver RN-FIN-020.
Payments__Asaas__WebhookSecret=CHANGE_ME
Payments__Asaas__WalletIdPlatform=CHANGE_ME

# Regra de split padrao da plataforma (%). Por tenant se sobrescreve em
# SplitRule, com historico. Mudanca aqui NAO reescreve cobranca antiga.
Payments__DefaultPlatformFeePercent=8.0
Payments__DefaultDepositPercent=40
Payments__MinDepositPercent=30
Payments__MaxDepositPercent=50
Payments__QuoteValidityDays=7
Payments__BalanceDueDays=7
Payments__BalanceDueDaysBeforeEvent=7
Payments__ReconciliationCron=0 5 * * *


# -----------------------------------------------------------------------------
#  Notificacoes                                                      [E2]
# -----------------------------------------------------------------------------
Notifications__Email__Provider=Smtp
Notifications__Email__Smtp__Host=localhost
Notifications__Email__Smtp__Port=1025
Notifications__Email__Smtp__UseSsl=false
Notifications__Email__Smtp__User=
Notifications__Email__Smtp__Password=
Notifications__Email__FromAddress=nao-responda@prata.localhost
Notifications__Email__FromName=Prata

# WhatsApp: na v1 apenas link wa.me, sem custo e sem template. Ver ADR-0007.
# A Cloud API entra na E5 e exige um WABA por tenant.
Notifications__WhatsApp__Mode=WaMeLink
Notifications__WhatsApp__CloudApi__Token=
Notifications__WhatsApp__CloudApi__PhoneNumberId=
Notifications__WhatsApp__CloudApi__TemplateLang=pt_BR


# -----------------------------------------------------------------------------
#  Galeria e entrega                                                 [E4]
# -----------------------------------------------------------------------------
Delivery__GalleryExpirationMonths=12
Delivery__ExpirationWarningDays=30,7,1
Delivery__ShareLinkTtlDays=90
Delivery__ShareLinkPasswordMinLength=6
Delivery__ZipMaxSizeGb=10
Delivery__DownloadJobTtlHours=48


# -----------------------------------------------------------------------------
#  LGPD - retencao                                                   [E2]
# -----------------------------------------------------------------------------
#  Bloco sensivel do briefing (docs/07-BRIEFING.md, bloco B) e apagado
#  automaticamente apos a entrega. Nao e opcional. Ver RN-LGP-004.
Privacy__SensitiveBriefingRetentionMonths=12
Privacy__AuditLogRetentionMonths=60
Privacy__DeletedClientPurgeDays=30


# -----------------------------------------------------------------------------
#  Observabilidade                                                   [E1]
# -----------------------------------------------------------------------------
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore=Warning
Serilog__WriteTo__Seq__ServerUrl=http://localhost:5341
Serilog__WriteTo__Seq__ApiKey=
OTEL_SERVICE_NAME=prata-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5342
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2


# -----------------------------------------------------------------------------
#  Rate limit                                                        [E1]
# -----------------------------------------------------------------------------
RateLimit__Anonymous__PermitPerMinute=60
RateLimit__Authenticated__PermitPerMinute=300
RateLimit__ShareLink__PermitPerMinute=20
RateLimit__Webhook__PermitPerMinute=600


# =============================================================================
#  FRONT-END  (web/.env.local)
# =============================================================================
#  NEXT_PUBLIC_* vai para o navegador. Nunca coloque segredo com esse prefixo.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
NEXT_PUBLIC_ROOT_DOMAIN=prata.localhost
NEXT_PUBLIC_CDN_BASE_URL=

# Chave de revalidacao do ISR. Server-side, sem prefixo publico.
REVALIDATE_SECRET=CHANGE_ME

# Camada de motion/WebGL. Ver docs/16-FRONTEND-E-EXPERIENCIA.md e ADR-0010.
# Interruptor global: derruba WebGL em todos os tenants sem redeploy do tema.
NEXT_PUBLIC_EFFECTS_ENABLED=true
NEXT_PUBLIC_EFFECTS_MIN_DEVICE_MEMORY_GB=4
NEXT_PUBLIC_EFFECTS_MIN_CPU_CORES=4

# Sentry: DSN e publico por natureza, o token de upload de sourcemap NAO e.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

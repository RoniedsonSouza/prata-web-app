# Prata - convencoes de codigo
# Referencia: docs/02-ARQUITETURA.md e docs/adr/ADR-0009-idioma-do-codigo.md
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 140

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false   # quebra de linha com dois espacos e significativa

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs,css,scss,glsl,frag,vert}]
indent_size = 2

[*.{csproj,props,targets,xml,config}]
indent_size = 2

[*.sql]
indent_size = 2

[*.sh]
indent_size = 2

# ===========================================================================
#  C#
# ===========================================================================
[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_between_query_expression_clauses = true

# --- using ---
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# --- estilo moderno obrigatorio ---
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:suggestion
dotnet_diagnostic.IDE0011.severity = none
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_readonly_struct = true:suggestion
csharp_style_prefer_utf8_string_literals = true:suggestion

# --- imutabilidade e seguranca ---
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_diagnostic.IDE0040.severity = warning
dotnet_style_prefer_collection_expression = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning

# --- this. desnecessario ---
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# ===========================================================================
#  Nomenclatura
#  Identificadores em ingles. Excecao unica: membros de enum de estado de
#  negocio, em portugues (OrderStatus.Rascunho). Ver ADR-0009.
# ===========================================================================
dotnet_naming_rule.interfaces_prefixed_with_i.severity                 = error
dotnet_naming_rule.interfaces_prefixed_with_i.symbols                  = interfaces
dotnet_naming_rule.interfaces_prefixed_with_i.style                    = prefix_i_pascal
dotnet_naming_symbols.interfaces.applicable_kinds                      = interface
dotnet_naming_style.prefix_i_pascal.required_prefix                    = I
dotnet_naming_style.prefix_i_pascal.capitalization                     = pascal_case

dotnet_naming_rule.types_are_pascal.severity                           = error
dotnet_naming_rule.types_are_pascal.symbols                            = types_and_members
dotnet_naming_rule.types_are_pascal.style                              = pascal
dotnet_naming_symbols.types_and_members.applicable_kinds               = class,struct,enum,delegate,method,property,event,namespace
dotnet_naming_style.pascal.capitalization                              = pascal_case

dotnet_naming_rule.private_fields_underscore.severity                  = error
dotnet_naming_rule.private_fields_underscore.symbols                   = private_fields
dotnet_naming_rule.private_fields_underscore.style                     = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds                  = field
dotnet_naming_symbols.private_fields.applicable_accessibilities        = private
dotnet_naming_style.underscore_camel.required_prefix                   = _
dotnet_naming_style.underscore_camel.capitalization                    = camel_case

dotnet_naming_rule.constants_are_pascal.severity                       = warning
dotnet_naming_rule.constants_are_pascal.symbols                        = constants
dotnet_naming_rule.constants_are_pascal.style                          = pascal
dotnet_naming_symbols.constants.applicable_kinds                       = field
dotnet_naming_symbols.constants.required_modifiers                     = const

dotnet_naming_rule.locals_are_camel.severity                           = warning
dotnet_naming_rule.locals_are_camel.symbols                            = locals
dotnet_naming_rule.locals_are_camel.style                              = camel
dotnet_naming_symbols.locals.applicable_kinds                          = local,parameter
dotnet_naming_style.camel.capitalization                               = camel_case

# ===========================================================================
#  Analisadores: o que quebra o build
# ===========================================================================
# Async sem await / await sem ConfigureAwait em biblioteca
dotnet_diagnostic.CS1998.severity = error
# Nullable: nao rebaixar para aviso. Dominio de dinheiro nao convive com null solto
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error
# CultureInfo explicita: dinheiro e data em produto brasileiro
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1310.severity = error
# Nao engolir excecao
dotnet_diagnostic.CA1031.severity = warning
# ConfigureAwait em Domain/Application
dotnet_diagnostic.CA2007.severity = none
# Colecao publica mutavel em agregado
dotnet_diagnostic.CA1002.severity = warning
dotnet_diagnostic.CA2227.severity = error
# Struct/record readonly
dotnet_diagnostic.CA1815.severity = suggestion
# ObsoleteAttribute sem mensagem
dotnet_diagnostic.CA1041.severity = warning
# IDE0005 using desnecessario
dotnet_diagnostic.IDE0005.severity = warning

# Nomes de dominio deliberados (glossario / Result pattern)
dotnet_diagnostic.CA1711.severity = none   # Collection e termo de negocio
dotnet_diagnostic.CA1716.severity = none   # Error e o tipo do Result pattern
dotnet_diagnostic.CA1000.severity = none   # Result<T>.Success/Failure estaticos
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.NU1903.severity = warning
dotnet_diagnostic.CS1591.severity = none   # XML docs no Domain entram gradualmente
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage - adotar depois
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.IDE0005.severity = none

# ---------------------------------------------------------------------------
#  Testes: regras relaxadas
# ---------------------------------------------------------------------------
[tests/**/*.cs]
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CS8618.severity = none
dotnet_diagnostic.CA1707.severity = none   # nome de teste com underscore e desejavel
dotnet_diagnostic.xUnit1051.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CS0618.severity = error

# ---------------------------------------------------------------------------
#  Migrations: geradas, nao revisadas por estilo
# ---------------------------------------------------------------------------
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
